#!/bin/bash
cd ${0%/*} || exit 1    # run from this directory

# Source OpenFOAM — works on both dev and container
OF_BASHRC="${WM_PROJECT_DIR:+$WM_PROJECT_DIR/etc/bashrc}"
if [ -z "$WM_PROJECT_DIR" ]; then
    for candidate in /opt/openfoam8/etc/bashrc /home/subratmcd/Softwares/OpenFOAM-8/etc/bashrc; do
        [ -f "$candidate" ] && OF_BASHRC="$candidate" && break
    done
fi
[ -f "$OF_BASHRC" ] && . "$OF_BASHRC"
# Source tutorial clean functions
[ -f "$WM_PROJECT_DIR/bin/tools/CleanFunctions" ] && . $WM_PROJECT_DIR/bin/tools/CleanFunctions

cleanCase

rm -rf constant/extendedFeatureEdgeMesh > /dev/null 2>&1
rm -f constant/polyMesh/boundary > /dev/null 2>&1

rm *.gif *.jpeg constant/triSurface/*
rm -f system/locationIn system/meshParameters system/refinementParam system/cubicBlock.json
rm blockParameters *.log site_boundary_average_velocity.txt
rm system/blockParameters system/optionalFeatures system/optionalGeometry system/optionalRefinementSurfaces system/optionalSurfaceFeatureSurfaces

# OBJ files are case inputs.  In particular, ground.obj may be generated by a
# separate preprocessing step, so cleaning the case must not delete it.
find constant/triSurface -maxdepth 1 -type f \
    \( -name '*.eMesh' -o -name '*.extendedFeatureEdgeMesh' \) -delete

