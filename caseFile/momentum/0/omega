FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

omegaInlet  0.00222; // epsilon / (Cmu * k) = 0.00003 / (0.09 * 0.15)

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInlet;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $omegaInlet;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform $omegaInlet;
        value           uniform $omegaInlet;
    }

    // Pond water surface: free-slip (flat, smooth surface; no wall shear, no wall functions).
    // Named explicitly so it overrides the `wall` patch group below (patch is called obj_ponds).
    obj_ponds
    {
        type            zeroGradient;
    }

    wall
    {
        type            omegaWallFunction;
        value           uniform $omegaInlet;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

