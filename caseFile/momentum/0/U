FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Uinlet  (-0.1656 -1.8928 0);

dimensions      [0 1 -1 0 0 0 0];

internalField   $Uinlet;	//uniform (0 0 0);


boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform $Uinlet;
    }

//    outlet
//    {
//        type            pressureInletOutletVelocity;
//        value           uniform (0 0 0);
//    }

    outlet
    {
        type        inletOutlet;
        inletValue  uniform (0 0 0);
        value       uniform (0 0 0);
    }

    // Pond water surface: free-slip (flat, smooth surface; no wall shear, no wall functions).
    // Named explicitly so it overrides the `wall` patch group below (patch is called obj_ponds).
    obj_ponds
    {
        type            slip;
    }

    // All snappy surfaces are type wall and are placed in this patch group.
    // This covers buildings, trees, land-cover surfaces, ponds and ground.
    wall
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

