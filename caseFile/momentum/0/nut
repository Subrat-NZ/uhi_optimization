FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    // Pond water surface: free-slip (flat, smooth surface; no wall shear, no wall functions).
    // Named explicitly so it overrides the `wall` patch group below (patch is called obj_ponds).
    obj_ponds
    {
        type            zeroGradient;
    }

    wall
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

