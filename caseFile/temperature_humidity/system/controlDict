FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     airTqFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// pseudo-time iterations (steady state). The run stops earlier when the
// residualControl of fvSolution is met (the final time is then written).
endTime         1000;

deltaT          1;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      2;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //
